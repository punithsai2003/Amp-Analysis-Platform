# Copy to .streamlit/secrets.toml for local development.
# NEVER commit the real secrets.toml — .gitignore already excludes it.
#
# On Streamlit Community Cloud, paste these into:
#   App menu -> Settings -> Secrets
#
# HF_API_KEY is OPTIONAL. Without it the app uses bigram pattern generation
# trained on your uploaded sequences, which needs no external service.
# Get a token at https://huggingface.co/settings/tokens (read scope is enough).

HF_API_KEY = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
